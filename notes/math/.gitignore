**/exports/
**/*.aux
**/*.log
**/*.out
**/*.toc
**/*.fdb_latexmk
**/*.fls
**/*.synctex.gz
**/*.synctex(busy)
**/*.pdfsync
**/*.bbl
**/*.blg
**/*.bcf
**/*.run.xml

# PDF and pagination artifacts are forbidden below notes/.
**/main.pdf
**/docs/*.pdf
**/pages/
**/contact-sheets/
